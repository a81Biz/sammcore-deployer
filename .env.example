# Configuración de Desarrollo Local - SAMMCORE Deployer
PORT=8080
DEPLOYER_API_KEY=your_secret_deployer_api_key
ALLOW_INSECURE_DEV=false
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80,https://deployer.sammcore.local
DATA_DIR=/data

# Base de Datos PostgreSQL (SAMMCORE o Local)
SUPABASE_HOST=192.168.68.107
SUPABASE_PORT=5432
SUPABASE_POSTGRES_PASSWORD=your_postgres_password

# Kubernetes API
KUBECONFIG=/root/.kube/config

# Frontend
VITE_API_BASE=/api
